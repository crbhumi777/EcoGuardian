{
  "name": "eco_guardian_agent",
  "description": "EcoGuardian – multi-agent sustainability assistant using Gemini and ADK",
  "entrypoint": "main_demo:run_agent_server",
  "runtime": {
    "language": "python",
    "version": "3.11"
  },
  "environment": {
    "GEMINI_API_KEY": "projects/PROJECT_ID/locations/global/secretManager/secretVersions/latest"
  },
  "resources": {
    "machine_type": "e2-standard-4"
  },
  "logging": {
    "level": "INFO"
  }
}
